pipeline {
    agent any

    tools {
        jdk 'jdk'
        nodejs 'nodejs'
    }

    environment {
        SCANNER_HOME = "${tool 'sonar-scanner'}"
        AWS_ACCOUNT_ID = credentials('ACCOUNT_ID')
        AWS_ECR_REPO_NAME = credentials('ECR_REPO1')
        AWS_DEFAULT_REGION = 'us-east-2'
        REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/"
        NVD_KEY = credentials('nvdApiKey')
    }

    stages {

        stage('Cleanup') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout From Git') {
            steps {
                git branch: 'main', credentialsId: 'github-token', url: 'https://github.com/hansonjohnny/demo.git'
            }
        }

        stage('Sonarqube Analysis') {
            steps {
                dir('Todo-app/frontend') {
                    withSonarQubeEnv('sonar-server') {
                        sh "${SCANNER_HOME}/bin/sonar-scanner -Dsonar.projectKey=cloud-native-backend -Dsonar.projectName=cloud-native-backend"
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    // Ensure SonarQube integration is properly configured to use this step
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar'
                }
            }
        }

        stage('OWASP Dependency-Check Scan') {
            steps {
                dir('Todo-app/frontend') {
                    withCredentials([string(credentialsId: 'nvdApiKey', variable: 'NVD_KEY')]) {
                        dependencyCheck additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit --nvdApiKey $NVD_KEY', odcInstallation: 'DP-Check'
                        dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                    }
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir('Todo-app/frontend') {
                    sh 'trivy fs . > trivyfs.txt'
                }
            }
        }

        stage("Docker Image Build") {
            steps {
                script {
                    dir('Todo-app/frontend') {
                            sh 'docker system prune -f'
                            sh 'docker container prune -f'
                            sh 'docker build -t ${AWS_ECR_REPO_NAME} .'
                    }
                }
            }
        }

        stage("TRIVY Image Scan") {
            steps {
                sh 'trivy image ${AWS_ECR_REPO_NAME} > trivyimage.txt' 
            }
        }

        stage("ECR Image Pushing") {
            steps {
                script {
                        sh 'aws ecr get-login-password --region ${AWS_DEFAULT_REGION} | docker login --username AWS --password-stdin ${REPOSITORY_URI}'
                        sh 'docker tag ${AWS_ECR_REPO_NAME} ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}'
                        sh 'docker push ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}'
                }
            }
        }

        stage('Checkout Code') {
            steps {
                 git branch: 'main', credentialsId: 'github-token', url: 'https://github.com/hansonjohnny/demo.git'
            }
        }

        // stage('Update Kubernetes Deployment') {
